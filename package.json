{
  "name": "sito-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "lint": "oxlint --type-aware --max-warnings 0",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky",
    "deploy": "firebase deploy --only hosting:sito-portfolio"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@fontsource/poppins": "5.2.6",
    "@fontsource/roboto": "5.2.6",
    "@fortawesome/fontawesome-svg-core": "7.0.0",
    "@fortawesome/free-brands-svg-icons": "7.0.0",
    "@fortawesome/free-solid-svg-icons": "7.0.0",
    "@fortawesome/react-fontawesome": "3.4.0",
    "@loadable/component": "5.16.7",
    "@sito/ui": "0.4.2",
    "@tailwindcss/vite": "4.3.2",
    "i18next": "25.3.2",
    "i18next-browser-languagedetector": "8.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "15.6.1",
    "react-router-dom": "7.18.2",
    "react-tooltip": "5.29.1",
    "some-javascript-utils": "0.10.10",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@types/loadable__component": "5.13.10",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "husky": "9.1.7",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "engines": {
    "node": "^22.13.0"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "i18next>typescript": "7",
        "react-i18next>typescript": "7"
      }
    }
  }
}
