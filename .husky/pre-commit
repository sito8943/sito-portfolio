#!/usr/bin/env sh
set -e

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm not found in PATH. Enable Corepack and retry." >&2
  exit 127
fi

pnpm run format
pnpm run lint:fix
