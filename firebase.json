{
  "hosting": {
    "site": "sito-portfolio",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/en/**",
        "destination": "/en/index.html"
      },
      {
        "source": "/es/**",
        "destination": "/es/index.html"
      },
      {
        "regex": "^[^.]*$",
        "destination": "/index.html"
      }
    ]
  }
}
